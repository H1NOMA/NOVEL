{
  "name": "helldivers-galactic-war",
  "private": true,
  "version": "0.48.0",
  "type": "module",
  "description": "Second Galactic War — real-time galactic strategy in the Helldivers 2 setting",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "assets:ships": "python3 tools/blender/shipforge.py --out src/assets/ships",
    "assets:keyart": "python3 tools/blender/keyart.py --out src/assets/keyart.webp",
    "assets:units": "python3 tools/blender/unitforge.py --out src/assets/units",
    "assets:menubg": "python3 tools/images/enhance.py bg --out src/assets/menubg.webp",
    "assets:menulogo": "python3 tools/images/enhance.py logo --out src/assets/menulogo.webp",
    "assets:planets": "python3 tools/blender/planetforge.py --out src/assets/planets",
    "app": "npm run build && electron .",
    "app:win": "npm run build && node scripts/package.mjs win32 x64",
    "app:linux": "npm run build && node scripts/package.mjs linux x64",
    "app:mac": "npm run build && node scripts/package.mjs darwin arm64"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/three": "^0.171.0",
    "electron": "^43.2.0",
    "three": "^0.171.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
